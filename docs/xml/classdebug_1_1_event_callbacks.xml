      <memberdef kind="function" id="classdebug_1_1_event_callbacks_1aef32a24e120836a6cb6da34f39a3fa6a" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>STDMETHOD</type>
        <definition>STDMETHOD debug::EventCallbacks::Exception</definition>
        <argsstring>(PEXCEPTION_RECORD64 exception, ULONG firstChance) override</argsstring>
        <name>Exception</name>
        <qualifiedname>debug::EventCallbacks::Exception</qualifiedname>
        <param>
          <type>PEXCEPTION_RECORD64</type>
          <declname>exception</declname>
        </param>
        <param>
          <type>ULONG</type>
          <declname>firstChance</declname>
        </param>
        <briefdescription>
<para>Called when an exception occurs in the target. </para>
        </briefdescription>
        <detaileddescription>
<para>Dispatches on exception code. EXCEPTION_BREAKPOINT goes to onBreakpoint: while launching it sets stopReason initialBreak, while isPausePending it sets pause, and otherwise (an int3 after launch) it sets exception, exceptionCode, and exceptionAddress. The MSVC thread-name exception is passed to the target. Other codes go to onUnknownException, which passes a first-chance exception to the target and sets exception on a second-chance exception.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>exception</parametername>
</parameternamelist>
<parameterdescription>
<para>Exception record describing the exception. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>firstChance</parametername>
</parameternamelist>
<parameterdescription>
<para>Non-zero if this is the first-chance notification. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>DEBUG_STATUS_BREAK to stop the target, or DEBUG_STATUS_GO_NOT_HANDLED to pass a first-chance exception through to the target. </para>
</simplesect>
</para>
        </detaileddescription>
