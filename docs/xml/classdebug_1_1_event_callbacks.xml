        <name>LoadModule</name>
        <qualifiedname>debug::EventCallbacks::LoadModule</qualifiedname>
        <param>
          <type>ULONG64</type>
          <declname>imageFileHandle</declname>
        </param>
        <param>
          <type>ULONG64</type>
          <declname>baseOffset</declname>
        </param>
