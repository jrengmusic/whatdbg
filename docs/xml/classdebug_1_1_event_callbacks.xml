        <type>STDMETHOD</type>
        <definition>STDMETHOD debug::EventCallbacks::Breakpoint</definition>
        <argsstring>(PDEBUG_BREAKPOINT bp) override</argsstring>
        <name>Breakpoint</name>
        <qualifiedname>debug::EventCallbacks::Breakpoint</qualifiedname>
        <param>
          <type>PDEBUG_BREAKPOINT</type>
          <declname>bp</declname>
        </param>
        <briefdescription>
<para>Called when a user-registered breakpoint is hit. </para>
        </briefdescription>
        <detaileddescription>
<para>Sets stopReason to breakpoint and breakpointEngineId, and sets executionState to stopped. EXCEPTION_BREAKPOINT events, including the initial loader break, go to Exception instead.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>bp</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the IDebugBreakpoint that was hit. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>DEBUG_STATUS_BREAK to keep the target stopped. </para>
</simplesect>
</para>
        </detaileddescription>
