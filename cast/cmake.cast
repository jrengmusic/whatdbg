```install-rename
COMMAND ${CMAKE_COMMAND} -E rm -f ":::installDirectory:::/${PROJECT_NAME}.old"
COMMAND ${CMAKE_COMMAND} -E touch ":::installDirectory:::/$<TARGET_FILE_NAME:${PROJECT_NAME}>"
COMMAND ${CMAKE_COMMAND} -E rename ":::installDirectory:::/$<TARGET_FILE_NAME:${PROJECT_NAME}>" ":::installDirectory:::/${PROJECT_NAME}.old"
COMMAND ${CMAKE_COMMAND} -E rename ":::installDirectory:::/$<TARGET_FILE_NAME:${PROJECT_NAME}>.tmp" ":::installDirectory:::/$<TARGET_FILE_NAME:${PROJECT_NAME}>"
```

